# Copy this file to .env and fill in your private values.
# Never commit .env.

GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# Generate a long random value and use the same value on Android/iOS clients.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANDROID_API_KEY=replace-with-random-upload-api-key

# Optional WeChat/PushPlus daily-report forwarding.
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# Optional VPN tuning.
VPN_OFF_COUNTRY_CODES=CN
VPN_REMOTE_CIDRS=
VPN_OFF_REMOTE_CIDRS=

# Set to 1 only when a trusted reverse proxy sits in front of the upload API;
# it makes VPN evidence honor X-Forwarded-For instead of the direct peer IP.
TRUSTED_PROXY_ENABLED=

# Optional server tuning (defaults shown in comments).
# HEARTBEAT_STALE_WARNING_HOURS=      # warn in Telegram when the phone stops pinging (2; 0 disables)
# HEARTBEAT_STALE_WARNING_COOLDOWN_HOURS=  # min gap between those warnings (12)
# MEAL_RELAY_HOST=            # legacy relay bind address (127.0.0.1)
# MEAL_RELAY_API_KEY=         # legacy relay key (falls back to ANDROID_API_KEY)
# MAX_API_UPLOAD_BYTES=       # upload size cap in bytes (26214400 = 25 MB)
# VPN_GEO_LOOKUP_ENABLED=     # IP geolocation for VPN evidence (true)
# CALORIE_BOT_SERVICE_NAME=   # systemd unit shown by /status (caloriebot.service)
# Gemini retry/quota and VPN-warning cooldown knobs also exist as env vars —
# see the constants at the top of telegram_bot.py.

# Optional Garmin daily-activity pull.
# GARMIN_ENABLED=            # 1 to enable (needs garminconnect + token dir)
# GARMIN_TOKEN_DIR=          # pre-minted ~/.garminconnect token directory
# GARMIN_NET_USE_TOTAL=      # 1: net against whole-day total, default active-only
# TEXT_EDIT_WINDOW_DAYS=     # NL correction lookback in days (7)
