# Copy this file to .env and fill in your private values.
# Never commit .env.

GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# Generate a long random value and use the same value on Android/iOS clients.
# Example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANDROID_API_KEY=replace-with-random-upload-api-key

# Optional WeChat/PushPlus daily-report forwarding.
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# Optional VPN tuning.
VPN_OFF_COUNTRY_CODES=CN
VPN_REMOTE_CIDRS=
VPN_OFF_REMOTE_CIDRS=
